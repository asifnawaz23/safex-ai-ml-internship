# Copy to .env (never commit .env) or set these in your PowerShell session:
#   $env:PII_PIPELINE_HMAC_KEY = "<long random local secret>"
#
# Key for keyed pseudonyms (HMAC-SHA256) in pii_pipeline.privacy.keyed_pseudonym.
# Only needed if you use pseudonymisation; redaction does not use it.
PII_PIPELINE_HMAC_KEY=replace-with-a-long-random-local-secret

# Console/file log level for the CLI (DEBUG, INFO, WARNING, ERROR).
PII_PIPELINE_LOG_LEVEL=INFO
